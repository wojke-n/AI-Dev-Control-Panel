<Window x:Class="AiDevControlPanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AiDevControlPanel.App.ViewModels"
        xmlns:views="clr-namespace:AiDevControlPanel.App.Views"
        Title="{Binding Title}"
        Icon="Assets/app.ico"
        MinWidth="1280" MinHeight="800"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AddProjectViewModel}">
            <views:AddProjectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <views:ProjectDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddTsaViewModel}">
            <views:AddTsaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TsaDetailViewModel}">
            <views:TsaDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IssueDetailViewModel}">
            <views:IssueDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionViewModel}">
            <views:QuestionView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Action bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="16"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Settings" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="150" IsEditable="True" ItemsSource="{Binding ModelOptions}"
                              Text="{Binding Model, UpdateSourceTrigger=LostFocus}"
                              ToolTip="Model alias or full model id for new Claude runs" />
                    <TextBlock Text="Effort:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox Width="110" ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding Effort}"
                              ToolTip="Effort level for new Claude runs" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- Missing prerequisites -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ErrorBackground}" Padding="10,6"
                Visibility="{Binding PrerequisiteWarning, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding PrerequisiteWarning}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Project panel -->
                <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,1" Background="{StaticResource PanelBackground}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE739;"
                                        Command="{Binding UncheckAllCommand}" ToolTip="Uncheck all projects" />
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE73A;"
                                        Command="{Binding CheckAllCommand}" ToolTip="Check all projects" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                                        Command="{Binding AddProjectCommand}" ToolTip="Add project" />
                                <TextBlock Text="Project" Style="{StaticResource PanelTitle}" />
                            </DockPanel>
                        </Border>
                        <ListBox Style="{StaticResource StateList}" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectItemViewModel}">
                                    <DockPanel ToolTip="{Binding ToolTip}">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="Show the TSAs and issues of this project" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- TSA panel -->
                <Border Grid.Row="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBackground}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                                        Command="{Binding AddTsaCommand}" ToolTip="Add TSA" />
                                <TextBlock Text="TSA" Style="{StaticResource PanelTitle}" />
                            </DockPanel>
                        </Border>
                        <ListBox Style="{StaticResource StateList}" ItemsSource="{Binding TsaView}" SelectedItem="{Binding SelectedTsa}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TsaItemViewModel}">
                                    <TextBlock x:Name="Title" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTitlePending}" Value="True">
                                            <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Issue panel -->
            <Border Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Issue" Style="{StaticResource PanelTitle}" />
                    </Border>
                    <ListBox Style="{StaticResource StateList}" ItemsSource="{Binding IssueView}" SelectedItem="{Binding SelectedIssue}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IssueItemViewModel}">
                                <DockPanel ToolTip="{Binding ToolTip}">
                                    <Border DockPanel.Dock="Right" Background="#33000000" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Priority">
                                        <TextBlock Text="{Binding Priority, StringFormat=P{0}}" FontSize="11" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE769;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Visibility="{Binding IsInterrupted, Converter={StaticResource VisibleWhen}}" ToolTip="Paused by the usage limit" />
                                    <TextBlock Text="{Binding Number, StringFormat=#{0}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main panel -->
            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource Muted}"
                       Text="Select a project, TSA or issue.&#x0a;Add a project with + in the Project panel to get started."
                       Visibility="{Binding CurrentView, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
            <ContentControl Grid.Column="2" Content="{Binding CurrentView}" Focusable="False" />
        </Grid>
    </DockPanel>
</Window>
