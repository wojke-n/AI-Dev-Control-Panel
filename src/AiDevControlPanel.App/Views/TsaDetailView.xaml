<UserControl x:Class="AiDevControlPanel.App.Views.TsaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AiDevControlPanel.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <ContentControl Content="{Binding Question}" Focusable="False" />

            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}">
                <Run Text="{Binding ProjectName, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding StateText, Mode=OneWay}" />
            </TextBlock>

            <Border Background="{StaticResource ErrorBackground}" CornerRadius="3" Padding="10" Margin="0,12,0,0"
                    Visibility="{Binding LastError, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding RetryCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding ActionError}" Foreground="DarkRed" TextWrapping="Wrap"
                       Visibility="{Binding ActionError, Converter={StaticResource VisibleWhen}}" />

            <TextBlock Text="Text" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
            </Border>

            <TextBlock Text="Issues" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="No issues yet." Style="{StaticResource Muted}"
                       Visibility="{Binding Issues.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                            <Run Text="{Binding Number, StringFormat=#{0}, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Title, Mode=OneWay}" />
                            <Run Text="{Binding State, StringFormat=({0}), Mode=OneWay}" Foreground="{StaticResource MutedText}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:ActivityView DataContext="{Binding Activity}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
