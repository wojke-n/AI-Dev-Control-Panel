<UserControl x:Class="AiDevControlPanel.App.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AiDevControlPanel.App.Controls"
             xmlns:views="clr-namespace:AiDevControlPanel.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="Open on GitHub" Command="{Binding OpenOnGitHubCommand}" Style="{StaticResource ActionButton}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" />
            <TextBlock Text="{Binding LocalPath}" Style="{StaticResource Muted}" Margin="0,0,0,8" />

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,8"
                         Visibility="{Binding IsInitializing, Converter={StaticResource VisibleWhen}}" />

            <Border Background="{StaticResource ErrorBackground}" CornerRadius="3" Padding="10" Margin="0,4,0,8"
                    Visibility="{Binding LastError, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding RetryCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding ActionError}" Foreground="DarkRed" TextWrapping="Wrap"
                       Visibility="{Binding ActionError, Converter={StaticResource VisibleWhen}}" />

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <controls:MarkdownView Markdown="{Binding Readme}" AssetPathRoot="{Binding LocalPath}" />
            </Border>

            <views:ActivityView DataContext="{Binding Activity}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
