<UserControl x:Class="AiDevControlPanel.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <CheckBox Content="Autostart planning?" IsChecked="{Binding AutostartPlanning}" Margin="0,8,0,0" />
        <TextBlock Text="Issues that are not blocked are planned automatically, highest priority first."
                   Style="{StaticResource Muted}" Margin="22,2,0,0" />
        <CheckBox Content="Autostart executing plan?" IsChecked="{Binding AutostartExecution}" Margin="0,16,0,0" />
        <TextBlock Text="A finished plan is implemented right away instead of waiting for 'Start execution'."
                   Style="{StaticResource Muted}" Margin="22,2,0,0" />
    </StackPanel>
</UserControl>
