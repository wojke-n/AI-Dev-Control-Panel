<UserControl x:Class="AiDevControlPanel.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="Activity" Margin="0,16,0,0">
        <Border Style="{StaticResource Card}" MaxHeight="320">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time, StringFormat=HH:mm:ss}" Style="{StaticResource Muted}"
                                           FontFamily="Consolas" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Consolas" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Expander>
</UserControl>
