<UserControl x:Class="AiDevControlPanel.App.Views.AddTsaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Add TSA" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Describe features, bugs or security issues in your own words. The refiner turns the text into GitHub issues and asks if something is ambiguous." />
            <TextBlock Text="No project is ready yet. Add a project first." Foreground="DarkRed" Margin="0,0,0,8"
                       Visibility="{Binding HasProjects, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
            <TextBlock Text="Project" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name"
                      Width="320" HorizontalAlignment="Left" Margin="0,0,0,12" />
            <TextBlock Text="Text" Margin="0,0,0,4" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Add TSA" Command="{Binding AddCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ActionError}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding ActionError, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="200" />
    </DockPanel>
</UserControl>
